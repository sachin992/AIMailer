# AIMailer Configuration Template
# Copy this file to .env and fill in your values

# ================================
# OpenAI Configuration
# ================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0

# ================================
# Gmail Configuration
# ================================
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ================================
# FAQ Configuration
# ================================
FAQ_EXCEL_FILE=faq.xlsx
VECTOR_STORE_FILE=faq.index
FAQ_SIMILARITY_THRESHOLD=2.0
FAQ_TOP_K_RESULTS=3

# ================================
# Email Filtering
# ================================
# Options: whitelist, blacklist, all
EMAIL_FILTER_MODE=whitelist
# Comma-separated list of email addresses
EMAIL_WHITELIST=example1@gmail.com,example2@gmail.com
EMAIL_BLACKLIST=
EMAIL_LABEL_FILTER=

# ================================
# Batch Processing
# ================================
MAX_EMAILS_PER_RUN=10
ENABLE_BATCH_PROCESSING=true

# ================================
# Retry Configuration
# ================================
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
INITIAL_RETRY_DELAY=1.0

# ================================
# Database Configuration
# ================================
DATABASE_ENABLED=true
DATABASE_PATH=aimailer.db

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=INFO
LOG_FILE=logs/aimailer.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ================================
# Human-in-the-Loop Configuration
# ================================
HITL_ENABLED=true
HITL_CONFIDENCE_THRESHOLD=0.7
HITL_AUTO_SEND_HIGH_CONFIDENCE=true

# ================================
# Rate Limiting
# ================================
OPENAI_RATE_LIMIT_RPM=60
GMAIL_RATE_LIMIT_QPM=250

# ================================
# Email Templates
# ================================
EMAIL_TEMPLATE_FOLDER=templates/email
DEFAULT_EMAIL_TEMPLATE=default.html
ENABLE_HTML_EMAILS=true

# ================================
# Monitoring & Analytics
# ================================
ENABLE_MONITORING=true
METRICS_EXPORT_INTERVAL=300

# ================================
# Admin Dashboard
# ================================
ADMIN_DASHBOARD_ENABLED=true
ADMIN_DASHBOARD_PORT=3000
ADMIN_API_PORT=5000
